# OverMem Plugin Runtime —— docker compose 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env

# ---- 镜像 ----
# 默认使用 GHCR 上的多架构镜像；本地构建时保持默认即可
OVERMEM_IMAGE=ghcr.io/serveryyswys/overmem-plugin-runtime
OVERMEM_TAG=0.1.0
# ---- 端口 ----
# 只监听回环地址，外部访问请走反向代理
OVERMEM_BIND=127.0.0.1
OVERMEM_PORT=8765

# ---- 安全 ----
# 生产环境建议固定 JWT 密钥，否则每次重建容器会让旧 token 全部失效
# OVERMEM_JWT_SECRET=change-me-to-a-long-random-string
OVERMEM_JWT_TTL=3600
# 设置后 /admin 管理后台走 HTTP Basic
# OVERMEM_ADMIN_USERNAME=admin
# OVERMEM_ADMIN_PASSWORD=change-me
# 首次启动预置的 API Key；不设则自动生成并写入 /data/data/bootstrap_key.txt
# OVERMEM_BOOTSTRAP_KEY=

# ---- 其它 ----
OVERMEM_LOGS_CAPACITY=500
